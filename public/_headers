# HTML：禁止缓存，避免部署后仍引用旧 hash 的 JS
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff

/
  Cache-Control: no-cache, no-store, must-revalidate
  X-Content-Type-Options: nosniff

# 带 hash 的静态资源：长期缓存
/static/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
